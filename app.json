{
  "expo": {
    "name": "Kleos",
    "slug": "aura",
    "scheme": "aura",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06071A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.avarice.aura",
      "infoPlist": {
        "NSCameraUsageDescription": "Kleos records a short clip of you answering a prompt so Poise can read how you come across. Clips are measured, never shared, and deleted after they are read.",
        "NSMicrophoneUsageDescription": "Kleos listens during conversations so the other person can reply and Poise can measure pace, fillers and tone.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.avarice.aura",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/splash-icon.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Kleos records a short clip so Poise can read how you come across.",
          "microphonePermission": "Kleos listens during conversations to measure your voice."
        }
      ],
      "expo-sharing",
      "expo-image",
      "@config-plugins/react-native-webrtc",
      "@livekit/react-native-expo-plugin",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/app"
      }
    }
  }
}
