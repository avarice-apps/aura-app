{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "resourceClass": "m-medium" },
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-with-your-server.up.railway.app" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-with-your-server.up.railway.app" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-with-your-server.up.railway.app",
        "EXPO_PUBLIC_RC_IOS_KEY": "appl_REPLACE",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_REPLACE",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "KLEOS_APPLE_SIGNIN": "1"
      }
    }
  },
  "submit": {
    "production": { "ios": { "ascAppId": "REPLACE_with_App_Store_Connect_app_id" } }
  }
}
